# Exemplo de arquivo de ambiente para este projeto
# Copie este arquivo para ".env" e ajuste conforme seu ambiente local/CI.
# NÃO comite o arquivo .env com segredos reais.

# Configurações da Aplicação
BASE_URL=http://analista-teste.seatecnologia.com.br

# Configurações de Teste
HEADLESS=False         # True para rodar em headless mode
TIMEOUT=10             # Timeout geral (segundos)
IMPLICIT_WAIT=10       # Espera implícita do WebDriver (segundos)

# Configurações de Evidências
SCREENSHOT_ON_FAILURE=True
EVIDENCE_PATH=evidence/screenshots

